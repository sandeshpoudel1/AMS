# Deployment-ready environment template for Project MOPL
# IMPORTANT: Fill secrets before use. Do NOT commit real secrets to git.
# Copy this file into your deployment host or hosting UI as environment variables.

# Application
APP_NAME=ProjectMOPL
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://api.example.com

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (MySQL example)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_mopl
DB_USERNAME=project_user
DB_PASSWORD=change_me

# Cache / Sessions / Queue
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Project MOPL"

# S3 / Storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Frontend / Auth integration
SANCTUM_STATEFUL_DOMAINS=app.example.com
SESSION_DOMAIN=.example.com
VITE_API_BASE_URL=https://api.example.com/api

# Misc
APP_TIMEZONE=UTC
TELESCOPE_ENABLED=false

# Notes:
# - Generate a secure APP_KEY locally and paste the value into APP_KEY.
#   Run: `php artisan key:generate --show`
# - Replace all `change_me` and empty values with real credentials and mark them as secret
#   in your hosting provider (Environment Variables / Secrets UI).
# - After deploying, run: `php artisan migrate --force` and `php artisan config:cache`.APP_NAME=MORMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://darkgoldenrod-rhinoceros-948310.hostingersite.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=morms_db
DB_USERNAME=morms_user
DB_PASSWORD=secure_password_123
